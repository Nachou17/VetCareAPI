# ========================================================
# Archivo de ejemplo para variables de entorno del Backend
# ASP.NET Core mapea la jerarquía de configuración con doble guión bajo (__)
# ========================================================

# Cadena de conexión hacia Microsoft SQL Server (LocalDB, SQLEXPRESS o contenedor)
ConnectionStrings__miconexion=Server=YOUR_SQL_SERVER;Database=veterinariodb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Configuración de Tokens JWT (Firma HMAC-SHA256, mínimo 32 caracteres)
Jwt__Key=YOUR_SUPER_SECRET_JWT_SIGNING_KEY_MIN_32_CHARS
Jwt__Issuer=VeterinariaAPI
Jwt__Audience=VeterinariaClient
Jwt__ExpireMinutes=60

# Poblado de datos de prueba para demostración (solo activo en entorno Development)
SeedDemoData=false

# Contraseña inicial común para cuentas demo sembradas en desarrollo local
SeedDemoPassword=YOUR_LOCAL_DEMO_PASSWORD

# Contraseñas individuales por rol para cuentas demo (Admin, Vet, Recep)
SeedDemoPasswords__Admin=YOUR_LOCAL_ADMIN_PASSWORD
SeedDemoPasswords__Vet=YOUR_LOCAL_VET_PASSWORD
SeedDemoPasswords__Recep=YOUR_LOCAL_RECEPCION_PASSWORD

# Flag para restablecimiento manual de contraseñas de cuentas demo existentes (solo una vez en Development)
ResetDemoPasswords=false
